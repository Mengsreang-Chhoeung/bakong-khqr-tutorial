# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# The Bakong Account ID a generated KHQR pays into. This is NOT secret —
# it's a payee identifier, the same idea as a bank account number, and is
# meant to be visible in the QR code itself.
BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_MERCHANT_NAME=Your Name
BAKONG_MERCHANT_CITY=Phnom Penh

# KHR (whole numbers, no decimals) is this guide's primary example currency.
# USD (decimals) is also supported by KHQR — see docs/01-getting-started.md,
# "Common Beginner Mistakes", for the formatting difference.
BAKONG_CURRENCY=KHR

# Only used by POST /check-payment-status — KHQR generation itself needs no
# network access or token at all. Obtained by registering at the Bakong
# Open API developer portal (https://api-bakong.nbc.gov.kh/). Exactly how
# this token is issued/renewed isn't fully confirmed from public docs — see
# the "Known intentional gaps" section in CLAUDE.md before building anything
# that tries to auto-fetch or refresh it.
BAKONG_ACCESS_TOKEN=your_bakong_access_token

# Sandbox/staging base URL by default. Swap to https://api-bakong.nbc.gov.kh/v1
# for production. Whether the sandbox host behaves like a consequence-free
# test environment (vs. requiring a real bank-linked account to pay into)
# is unconfirmed — see docs/01-getting-started.md's Testing Checklist.
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh/v1

PORT=3000
