# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# The Bakong Account ID a generated KHQR pays into. This is NOT secret —
# it's a payee identifier, the same idea as a bank account number, and is
# meant to be visible in the QR code itself.
BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_MERCHANT_NAME=Your Name
BAKONG_MERCHANT_CITY=Phnom Penh

# KHR (whole numbers, no decimals) is this guide's primary example currency.
# USD (decimals) is also supported by KHQR — see https://mengsreang-chhoeung.work/tutorials/bakong-khqr-tutorial,
# "Common Beginner Mistakes", for the formatting difference.
BAKONG_CURRENCY=KHR

# Only used by POST /check-payment-status — KHQR generation itself needs no
# network access or token at all. Obtained by registering at the Bakong
# Open API developer portal (https://api-bakong.nbc.gov.kh/).
BAKONG_ACCESS_TOKEN=your_bakong_access_token

# Bakong Open API base URL.
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh/v1

PORT=3000
